{
    "extends": "@financeiro/config/base",
    "compilerOptions": {
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "skipLibCheck": true,
        "strict": true,
        "target": "ESNext",
        "esModuleInterop": true
    },
    "include": [
        "src/**/*",
        "*.ts",
        "*.tsx"
    ]
}